                      "type": "text",
                      "id": "b9BSN",
                      "name": "A",
                      "fill": "$fg-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "vendor 的并发 / RPM / TPM 是按整个 vendor 账号算的,同车的人共享一个上游账号,所以理论上会互相占用。我们的建议:\n\n· 用量特别大的场景 → 独享,一辆车就你一个人跑,并发不跟人抢;\n· 想同时挂多家 vendor 分流 → 每家 vendor 各起一辆独享,不同 vendor 之间的配额彼此独立;\n· 日常轻量、突发式使用 → 拼车没问题,系统会调度请求错峰,大部分场景感知不到抢占。",
                      "lineHeight": 1.7,
                      "fontFamily": "$font",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
